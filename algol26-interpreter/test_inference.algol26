begin
  // Conditioned Bernoulli: should always sample true
  var d := bernoulli(0.6) given _sample = true;
  var s := sample(d);
  println("Sample from conditioned Bernoulli (should be true): ", s);

  // Conditioned uniform: samples restricted to 6..9
  var d2 := uniform(6, 9);
  println("Samples from uniform(6,9): ");
  for i: 1 to 10 do
    println(sample(d2), " ");
  println();
end
